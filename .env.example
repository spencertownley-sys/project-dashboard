# Postgres. Leave unset locally to use the PGlite file database in .data/pglite.
DATABASE_URL=

# Clerk. Leave both unset locally to run without sign-in (dev only).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Comma-separated emails allowed to use the dashboard.
OWNER_EMAILS=

# Shared secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Sync sources. Each one is skipped when its token is missing.
GITHUB_TOKEN=
VERCEL_TOKEN=
VERCEL_TEAM_ID=
SUPABASE_ACCESS_TOKEN=

# Set to 1 only to run a production build without Clerk (e.g. a local smoke test).
ALLOW_NO_AUTH=
# Where the local PGlite database lives.
PGLITE_DIR=.data/pglite
